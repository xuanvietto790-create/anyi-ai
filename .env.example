DEEPSEEK_API_KEY=replace-with-your-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_VISION_MODEL=deepseek-flash
DEEPSEEK_SEARCH_URL=https://api.deepseek.com/v1/tools/search
ANYI_DATA_DIR=E:/Codex/work/anyi-ai-data
ANYI_TEMP_DIR=E:/Codex/tmp/anyi-ai
DEEPSEEK_TOKENIZER_PATH=E:/Codex/tool-cache/models/deepseek-v4-tokenizer.json
ANYI_VOSK_MODEL=E:/Codex/tool-cache/models/vosk-model-small-cn-0.22
# 正式账号服务 HTTPS 根地址或 /api 地址，复用 anyi-node 的账号与阿里云短信
ANYI_AUTH_BASE_URL=
# 仅用于 localhost 联调，正式 HTTPS 地址下不会暴露模拟验证码
ANYI_AUTH_ALLOW_MOCK=false
